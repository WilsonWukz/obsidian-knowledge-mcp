{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-knowledge-mcp-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "11111111111111111111111111111111" }
  ],
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "synthetic-test-only-vault" },
    { "binding": "SYNC_OBJECTS", "bucket_name": "synthetic-guarded-sync-objects" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "ObsidianMCP" },
      { "name": "REVIEW_PLANS", "class_name": "ReviewPlans" },
      { "name": "SYNC_LEDGER", "class_name": "GuardedSyncLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ObsidianMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["ReviewPlans"] },
    { "tag": "v3", "new_sqlite_classes": ["GuardedSyncLedger"] }
  ],
  "vars": {
    "VAULT_PREFIX": "",
    "ENABLE_REVIEWED_WRITES": "false",
    "ENABLE_GUARDED_SYNC": "true",
    "ENABLE_GUARDED_SYNC_API": "false",
    "ENABLE_SYNC_ADOPTION": "false",
    "GUARDED_SYNC_CUTOVER": "false",
    "DAILY_NOTE_PATH_TEMPLATE": "Daily Notes/{{YYYY-MM-DD}}.md",
    "WEEKLY_NOTE_PATH_TEMPLATE": "",
    "MONTHLY_NOTE_PATH_TEMPLATE": "",
    "QUARTERLY_NOTE_PATH_TEMPLATE": "",
    "YEARLY_NOTE_PATH_TEMPLATE": "",
    "PERMALINK_BASE_URL": "",
    "SERVICE_BASE_URL": "https://vault.example.test",
    "ATTACHMENTS_PATH_MODE": "per_note_subfolder",
    "ATTACHMENTS_SUBFOLDER": "files",
    "ATTACHMENT_ALLOWED_EXTENSIONS": "png,jpg,jpeg,gif,webp,svg,pdf",
    "ATTACHMENT_FETCH_HOST_ALLOWLIST": "",
    "ATTACHMENT_MAX_BYTES": 26214400,
    "ATTACHMENTS_MOVE_WITH_NOTE": "unique_refs",
    "ATTACHMENT_URL_TIMEOUT_MS": 20000
  }
}
